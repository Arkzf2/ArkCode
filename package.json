{
  "name": "arkcode",
  "version": "0.1.0",
  "description": "A focused terminal coding agent powered by Pi",
  "type": "module",
  "bin": { "arkcode": "dist/cli.js" },
  "files": ["dist", "scripts/patch-pi-sdk.mjs", "scripts/pi-sdk-patch", "README.md", "README-CN.md", "CONTRIBUTING.md", "docs"],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "node scripts/build.mjs",
    "check": "tsc -p tsconfig.test.json",
    "schemas:shell": "tsx scripts/shell-schemas.mjs",
    "docs:generate": "tsx scripts/docs-reference.mjs",
    "docs:check": "tsx scripts/check-docs.mjs",
    "test": "tsx --test --test-concurrency=4 test/*.test.ts",
    "start": "node dist/cli.js",
    "postinstall": "node scripts/patch-pi-sdk.mjs",
    "predev": "node scripts/patch-pi-sdk.mjs",
    "prebuild": "node scripts/patch-pi-sdk.mjs",
    "precheck": "node scripts/patch-pi-sdk.mjs",
    "pretest": "node scripts/patch-pi-sdk.mjs",
    "prepack": "npm run build"
  },
  "engines": { "node": ">=22.19.0" },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-mcp": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "bash-parser": "0.5.0",
    "jsonc-parser": "3.3.1",
    "minimatch": "10.2.6",
    "typebox": "1.3.27",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@xterm/headless": "6.0.0",
    "tsx": "4.22.1",
    "typescript": "5.9.3"
  }
}
