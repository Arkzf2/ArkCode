                  "const": "stop_unconfirmed"
                },
                {
                  "type": "string",
                  "const": "cleanup_failed"
                }
              ],
              "description": "Why this observation returned. wait_limit leaves the process running and does not mean failure or execution timeout."
            },
            "wall_time_seconds": {
              "type": "number",
              "minimum": 0,
              "description": "Actual elapsed time of this bash or shell_control call in seconds, including execution preparation, input delivery, observation and output capture, excluding approval. Not cumulative process lifetime; an already-finished session returns immediately."
            },
            "message": {
              "type": "string",
              "description": "Host continuation guidance for a running process. A named observation window is the requested wait budget in milliseconds, not measured elapsed time. Use the same session_id rather than launching the command again."
